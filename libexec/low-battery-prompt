#!/usr/bin/env bash

result_file=$1
printf '\033[1;33m배터리가 10%% 이하입니다.\033[0m\n'
printf '30초 후 자동으로 절전 모드에 들어갑니다.\n'
printf '취소하려면 이 창에서 아무 키나 누르세요.\n'
printf '취소하면 배터리가 다시 10%%를 넘을 때까지 재시도하지 않습니다.\n\n'

if IFS= read -r -s -n 1 -t 30 _; then
    printf '\n절전을 취소했습니다.\n'
    exit 0
else
    read_status=$?
fi

if (( read_status > 128 )); then
    printf 'timeout\n' > "$result_file"
fi
